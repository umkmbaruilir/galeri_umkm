generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Umkm {
  id          String    @id @default(uuid())
  name        String
  owner       String
  description String
  address     String
  whatsapp    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  coverImage  String?
  category    String?
  views       Int       @default(0)
  galleries   Gallery[]
}

model Gallery {
  id        String   @id @default(uuid())
  imageUrl  String
  umkmId    String
  createdAt DateTime @default(now())
  umkm      Umkm     @relation(fields: [umkmId], references: [id], onDelete: Cascade)
}

model News {
  id        String   @id @default(uuid())
  title     String
  content   String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
